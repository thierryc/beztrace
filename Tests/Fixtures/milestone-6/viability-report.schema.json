{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beztrace.dev/schemas/test/viability-report-v1.json",
  "title": "beztrace Milestone 6 viability decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "milestone",
    "decision",
    "mergeEligible",
    "publicationAuthorized",
    "gates"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "milestone": {"const": 6},
    "decision": {"enum": ["approve", "reject"]},
    "mergeEligible": {"type": "boolean"},
    "publicationAuthorized": {"type": "boolean"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "required", "status", "details"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {
            "enum": ["pass", "fail", "pending", "missing", "not-authorized"]
          },
          "details": {"type": "object"}
        }
      }
    }
  }
}
