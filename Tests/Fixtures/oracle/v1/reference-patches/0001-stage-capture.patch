+// Copyright 2026 the img2bez Authors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Test-only stage capture hooks used by beztrace's pinned oracle.
+
+#[cfg(feature = "cli")]
+use std::path::PathBuf;
+#[cfg(feature = "cli")]
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[cfg(feature = "cli")]
+static CONTOUR_INDEX: AtomicUsize = AtomicUsize::new(0);
+
+pub(crate) fn enabled() -> bool {
+    std::env::var_os("BEZTRACE_CAPTURE_DIR").is_some()
+}
+
+#[cfg(feature = "cli")]
+fn directory() -> Option<PathBuf> {
+    std::env::var_os("BEZTRACE_CAPTURE_DIR").map(PathBuf::from)
+}
+
+#[cfg(feature = "cli")]
+pub(crate) fn fixture_id() -> String {
+    std::env::var("BEZTRACE_CAPTURE_FIXTURE")
+        .unwrap_or_else(|_| "unknown".into())
+}
+
+#[cfg(feature = "cli")]
+pub(crate) fn next_contour_index() -> usize {
+    CONTOUR_INDEX.fetch_add(1, Ordering::SeqCst)
+}
+
+#[cfg(feature = "cli")]
+pub(crate) fn write_json(name: &str, value: &serde_json::Value) {
+    let Some(directory) = directory() else { return };
+    std::fs::create_dir_all(&directory)
+        .expect("create beztrace capture directory");
+    let bytes =
+        serde_json::to_vec_pretty(value).expect("serialize beztrace stage");
+    std::fs::write(directory.join(format!("{name}.json")), bytes)
+        .expect("write beztrace stage");
+}
+
+#[cfg(not(feature = "cli"))]
+pub(crate) fn write_json(_name: &str, _value: &()) {}
+
+#[cfg(feature = "cli")]
+pub(crate) fn path_value(path: &kurbo::BezPath) -> serde_json::Value {
+    use kurbo::PathEl;
+    let elements: Vec<_> = path.elements().iter().map(|element| match element {
+        PathEl::MoveTo(p) => serde_json::json!({"type":"move","x":p.x,"y":p.y}),
+        PathEl::LineTo(p) => serde_json::json!({"type":"line","x":p.x,"y":p.y}),
+        PathEl::QuadTo(a,b) => serde_json::json!({"type":"quad","points":[[a.x,a.y],[b.x,b.y]]}),
+        PathEl::CurveTo(a,b,c) => serde_json::json!({"type":"curve","points":[[a.x,a.y],[b.x,b.y],[c.x,c.y]]}),
+        PathEl::ClosePath => serde_json::json!({"type":"close"}),
+    }).collect();
+    serde_json::json!({"elements": elements})
+}
+
+#[cfg(feature = "cli")]
+pub(crate) fn write_paths(stage: &str, paths: &[kurbo::BezPath]) {
+    if !enabled() {
+        return;
+    }
+    let contours: Vec<_> = paths.iter().enumerate().map(|(index, path)| {
+        serde_json::json!({"index": index, "closed": true, "path": path_value(path)})
+    }).collect();
+    write_json(
+        stage,
+        &serde_json::json!({
+            "schemaVersion": 1,
+            "sourceRevision": "23073ca08ecdac61ad0e838bfae49a590bc2c7cc",
+            "fixtureID": fixture_id(),
+            "stage": stage,
+            "coordinateSpace": "canonical-y-up",
+            "contours": contours
+        }),
+    );
+}
+
+#[cfg(not(feature = "cli"))]
+pub(crate) fn write_paths(_stage: &str, _paths: &[kurbo::BezPath]) {}
