{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beztrace.dev/test-schema/oracle-manifest-v1.json",
  "title": "beztrace immutable oracle manifest v1",
  "type": "object",
  "required": ["schemaVersion", "sourceRevision", "instrumentationPatchSHA256", "environment", "commands", "timingConvention", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceRevision": {"const": "23073ca08ecdac61ad0e838bfae49a590bc2c7cc"},
    "referenceUFOSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrumentationPatchSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "object"},
    "commands": {"type": "array", "items": {"type": "string"}},
    "timingConvention": {"type": "object"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
